# INWX MCP Server Configuration
# ================================
#
# IMPORTANT: OTE (sandbox) and Live use DIFFERENT accounts!
# - OTE:  Register at https://ote.inwx.de (free, for testing)
# - Live: Register at https://www.inwx.de (real money!)
#
# Always test in OTE first before using live credentials!

# Required: Your INWX credentials
INWX_USERNAME=your-ote-username
INWX_PASSWORD=your-ote-password

# Environment: "ote" for sandbox (default), "live" for production
# WARNING: "live" mode will incur real costs!
INWX_ENVIRONMENT=ote

# Optional: 2FA shared secret (only if 2FA is enabled on your account)
# INWX_SHARED_SECRET=your-2fa-shared-secret
